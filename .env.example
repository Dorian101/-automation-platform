BOT_TOKEN=your_bot_token_here
APP_NAME=automation-platform
DEBUG=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=automation_platform
DB_USER=automation
DB_PASSWORD=
PROXY_URL=
# Web interface. Bind to loopback and reach it through a reverse proxy rather
# than exposing this port directly.
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Shared secret the proxy must send in the X-Platform-Auth header.
# Generate with: openssl rand -hex 32
WEB_ACCESS_TOKEN=
# Web accounts. Accounts themselves are created only from the host with:
#   python -m app.manage create-user <username>
SESSION_TTL_DAYS=30
# Keep true in production. Set false only for local http:// development, where
# a Secure cookie would never be sent back to the browser.
SESSION_COOKIE_SECURE=true
