BOT_TOKEN=your_bot_token_here
APP_NAME=automation-platform
DEBUG=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=automation_platform
DB_USER=automation
DB_PASSWORD=
# Connection pool. At most DB_POOL_MAX_SIZE connections are open at once,
# whatever the request rate, and a request that cannot borrow one within
# DB_POOL_TIMEOUT_SECONDS fails fast instead of queueing. Raise these when the
# process grows workers or the site opens up.
DB_POOL_MIN_SIZE=0
DB_POOL_MAX_SIZE=20
DB_POOL_TIMEOUT_SECONDS=5
PROXY_URL=
# The name readers type, used for the sitemap and the canonical links. It has
# no default on purpose: a default here would be one deployment's domain
# written into every clone of this repository. Unset, /sitemap.xml answers 404.
PUBLIC_BASE_URL=
# Web interface. Bind to loopback and reach it through a reverse proxy rather
# than exposing this port directly.
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Shared secret the proxy must send in the X-Platform-Auth header.
# Generate with: openssl rand -hex 32
WEB_ACCESS_TOKEN=
# Secret the session CSRF tokens are signed with. It has to survive a restart,
# or every form held open across one comes back expired. Leave it empty and a
# random value is used per process, which is safe but makes a deploy look like
# it broke somebody's page.
# Generate with: openssl rand -hex 32
CSRF_SECRET=
# Sliding-window limits on the public forms, per address. A login costs about
# 0.26s of blocked event loop, so these are the numbers that decide how long one
# address can make the whole site wait.
#
# LOGIN_ATTEMPTS_PER_WINDOW counts per address *and* username, so one person's
# typos do not lock out an office sharing their address.
# LOGIN_ATTEMPTS_PER_ADDRESS_PER_WINDOW counts every attempt from one address
# regardless of the name tried, which is what stops a fresh username being a
# fresh allowance. Keep it comfortably above the per-user number.
#
# 0 disables a limit, which only makes sense behind a limiting edge of your own.
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_ATTEMPTS_PER_WINDOW=5
LOGIN_ATTEMPTS_PER_ADDRESS_PER_WINDOW=20
# The demonstration writes on every page load rather than only on a submit, so
# its cap is an order of magnitude above a real visit: one address must not be
# able to fill a namespace in an hour.
DEMO_ATTEMPTS_PER_WINDOW=200
DEMO_WINDOW_SECONDS=3600
# Sign-ups are limited to keep a bot or a scraper from filling the table.
SIGNUP_ATTEMPTS_PER_WINDOW=10
SIGNUP_WINDOW_SECONDS=3600
# Web accounts. Registration is open only when this is set to a truthy value
# (true / 1 / yes); anything else, or leaving it unset, means /signup answers
# 404 and the login page shows no link.
SIGNUP_OPEN=false
# Accounts can also be created from the host, with no browser involved:
#   python -m app.manage create-user <username>
SESSION_TTL_DAYS=30
# Time zone the administration pages show timestamps in. Rows are stored in
# UTC, so this only changes what a person reads and an existing log stays
# correct. Any IANA name, for example Europe/Moscow.
DISPLAY_TIMEZONE=UTC
# Addresses whose requests leave no row in the visit log, comma separated:
#   VISIT_IGNORE_IPS=203.0.113.9,198.51.100.4
# The owner reads that log to see whether anybody else came, and their own
# checking is otherwise indistinguishable from a stranger's. The address is
# compared and then discarded — it is never stored, which is what the rest of
# the log is built on. Keep addresses out of this file's commits: it is
# tracked. Empty records everything.
VISIT_IGNORE_IPS=
# Secret that lets a request stay out of the visit log, sent as the header
# X-Platform-Probe. An address only covers the machine it was written on, so
# this covers work done from anywhere — measuring the site from elsewhere
# arrives from every address in turn and none of them is in the list above.
# Generate with: openssl rand -hex 32
#   curl -H "X-Platform-Probe: <the secret>" https://<domain>/about
# Not a way to keep a visitor out: anyone holding it can hide. It keeps the
# owner's own working out of a count that answers one question — was anybody
# here. Empty trusts nothing, so leave it unset if nothing probes the site.
VISIT_PROBE_TOKEN=
# Telegram linking. Both values are needed before the console offers the link
# button; leave TELEGRAM_BOT_USERNAME empty and the whole flow stays hidden,
# which is what a deployment that never registered a domain with @BotFather
# should see. To enable it:
#   1. /setdomain in @BotFather, pointed at the domain the console is served on
#   2. TELEGRAM_BOT_USERNAME here, without the leading @
# How long a Login Widget payload stays acceptable. A signature never stops
# being valid, so without this a captured one could be replayed much later.
TELEGRAM_BOT_USERNAME=
TELEGRAM_LOGIN_MAX_AGE_SECONDS=300
# Keep true in production. Set false only for local http:// development, where
# a Secure cookie would never be sent back to the browser.
SESSION_COOKIE_SECURE=true

# Database backups, written by `python -m app.manage backup`.
# Empty means <repo>/backups, which is fine locally. On a server point it
# outside the working tree so the backups live apart from the checkout.
BACKUP_DIR=
# Backups older than this are deleted after each run. 0 keeps everything.
BACKUP_RETENTION_DAYS=14
