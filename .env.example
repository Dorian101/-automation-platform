BOT_TOKEN=your_bot_token_here
APP_NAME=automation-platform
DEBUG=false
DB_HOST=localhost
DB_PORT=5432
DB_NAME=automation_platform
DB_USER=automation
DB_PASSWORD=
PROXY_URL=
# Web interface. Bind to loopback and reach it through a reverse proxy rather
# than exposing this port directly.
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Shared secret the proxy must send in the X-Platform-Auth header.
# Generate with: openssl rand -hex 32
WEB_ACCESS_TOKEN=
# Web accounts. The sign-up page only exists when an invite code is set; leave
# this empty and /signup answers 404 and the login page shows no link.
# Generate with: openssl rand -hex 16
SIGNUP_INVITE_CODE=
# Accounts can also be created from the host, with no browser involved:
#   python -m app.manage create-user <username>
SESSION_TTL_DAYS=30
# Keep true in production. Set false only for local http:// development, where
# a Secure cookie would never be sent back to the browser.
SESSION_COOKIE_SECURE=true

# Database backups, written by `python -m app.manage backup`.
# Empty means <repo>/backups, which is fine locally. On a server point it
# outside the working tree so the backups live apart from the checkout.
BACKUP_DIR=
# Backups older than this are deleted after each run. 0 keeps everything.
BACKUP_RETENTION_DAYS=14
